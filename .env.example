# Copy to .env.local and fill in. Never commit real values.

# Database: a folder → embedded PGlite (offline laptop); a postgres:// URL → Postgres (Neon in production)
DATABASE_URL=./data/pglite

# Active brand folder in /brands. In demo mode, ?brand=<slug> overrides it per browser.
BRAND=druri-design
# Demo conveniences: ?brand=, one-tap logins, the demo bar, reset, /setup, the fixtures endpoint.
# Must be false for real clients.
DEMO_MODE=true
# Demo: the reachable HTTPS demo. QR codes and tracking links in prepared messages use it, so the
# owner's phone can open them while this laptop runs offline. Ignored when APP_URL is set.
DEMO_PUBLIC_URL=https://order-tracking-test.vercel.app
# Online demo only: reseed the demo data on the first request of each day (true/false).
DEMO_DAILY_RESET=false

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the app's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Other origins allowed to log in (comma-separated), e.g. the laptop's LAN address for a phone
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100

# Public address of the app (deployments): tracking links in messages use it. Locally the request host is used.
APP_URL=

# Fixture logins (arben@druri.test = Pronari, teuta@druri.test = Zyra) share this password
FIXTURE_PASSWORD=
# Lets `pnpm fixtures` reset the database through the running app (demo mode only)
FIXTURES_TOKEN=
# PIN for /setup (demo mode only)
SETUP_PIN=

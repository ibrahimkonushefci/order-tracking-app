# Copy to .env.local and fill in. Never commit real values.

# Database: a folder → embedded PGlite (offline laptop); a postgres:// URL → Postgres (Neon in production)
DATABASE_URL=./data/pglite

# Brand folder in /brands shown on the login page. Signed in, each user sees their own company's brand.
BRAND=druri-design

# Better Auth: a long random secret (e.g. `openssl rand -base64 32`) and the app's public URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Other origins allowed to log in (comma-separated), e.g. the laptop's LAN address for a phone
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3100

# Public address of the app (deployments): tracking links in messages use it. Locally the request host is used.
APP_URL=

# Local tests only (never set online). Fixture logins (arben@druri.test = Pronari,
# teuta@druri.test = Zyra) share this password.
FIXTURE_PASSWORD=
# Lets `pnpm fixtures` and the e2e tests reset the local database through the running app.
# The endpoint doesn't exist on a postgres:// database.
FIXTURES_TOKEN=
